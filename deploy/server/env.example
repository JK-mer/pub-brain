# Copy to deploy/server/.env on the server, chmod 600. Gitignored — never committed.
#
# Model key: replaces the desktop keyring (`secret-tool`), which a headless
# box does not have. `llm.api_key` reads the env first (#48).
PUBBRAIN_LLM_API_KEY=

# Endpoint of any OpenAI-compatible chat API (vendor or self-hosted gateway).
PUBBRAIN_LLM_BASE_URL=

# App-level tokens — the second lock behind the tunnel's access policy and
# connector OAuth. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBBRAIN_WEB_TOKEN=
PUBBRAIN_MCP_TOKEN=
